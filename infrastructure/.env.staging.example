# ============================================================
# SportHub Connect — Staging Environment Configuration
# ============================================================
# Copy this file to .env.staging and fill in the values.
# These are the environment variables the application needs.
# Secrets are stored in GitHub Secrets or Azure Key Vault.
# ============================================================

# ─── Connection Strings ─────────────────────────────────────
ConnectionStrings__PostgreSQL="Host=psql-sport-staging.postgres.database.azure.com;Port=5432;Database=sporthub;Username=sporthub_admin;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true"
ConnectionStrings__Redis="redis-sport-staging.redis.cache.windows.net:6380,password=CHANGE_ME,ssl=True,abortConnect=False"
ConnectionStrings__RabbitMQ="amqp://sporthub:CHANGE_ME@sport-sb-staging.servicebus.windows.net:5671"  # Or Azure Service Bus

# ─── Auth0 ──────────────────────────────────────────────────
Auth0__Domain="sporthub-dev.auth0.com"
Auth0__Audience="https://api.sporthub.app"
Auth0__ClientId="CHANGE_ME"
Auth0__ClientSecret="CHANGE_ME"

# ─── Azure Service Bus (replaces RabbitMQ in cloud) ─────────
ServiceBus__ConnectionString="Endpoint=sb://sb-sport-staging.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=CHANGE_ME"

# ─── Application Insights / OpenTelemetry ───────────────────
ApplicationInsights__InstrumentationKey="CHANGE_ME"
OTEL_EXPORTER_OTLP_ENDPOINT="https://api.diagnostics.azure.com/"

# ─── Web (Next.js) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://ca-sport-staging-api.ambitiousrock-abc123.eastus.azurecontainerapps.io"
