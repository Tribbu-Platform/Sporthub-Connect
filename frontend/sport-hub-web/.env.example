# ============================================================
# Environment Variables - SportHub Connect Web
# ============================================================

# API
# API_UPSTREAM_URL tiene prioridad sobre NEXT_PUBLIC_API_URL en el proxy
# de src/app/api/[[...path]]/route.ts (orden: API_UPSTREAM_URL → NEXT_PUBLIC_API_URL → http://localhost:5000)
NEXT_PUBLIC_API_URL=http://localhost:5000
API_UPSTREAM_URL=http://localhost:5000

# Auth0
NEXT_PUBLIC_AUTH0_DOMAIN=sporthub-dev.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.sporthub.local

# Stripe (Public Key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Feature Flags
NEXT_PUBLIC_ENABLE_GAMIFICATION=true
NEXT_PUBLIC_ENABLE_LEADERBOARDS=true
NEXT_PUBLIC_ENABLE_PAYMENTS=false
